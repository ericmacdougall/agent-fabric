{
  "argv": [
    "/bin/true",
    "-p",
    "$PROMPT",
    "--output-format",
    "stream-json",
    "--verbose",
    "--model",
    "fake-model",
    "--effort",
    "n/a",
    "--max-turns",
    "5",
    "--max-budget-usd",
    "0.01",
    "--permission-mode",
    "acceptEdits",
    "--exclude-dynamic-system-prompt-sections",
    "--setting-sources",
    ""
  ],
  "env": [
    "CLAUDE_CODE_DISABLE_CLAUDE_MDS=1",
    "CLAUDE_CONFIG_DIR=$WORK/run/r_argvg_1/claude-config",
    "XDG_CACHE_HOME=$WORK/run/r_argvg_1/cache",
    "XDG_CONFIG_HOME=$WORK/run/r_argvg_1/config",
    "GIT_CONFIG_GLOBAL=$WORK/run/r_argvg_1/config/git/config",
    "GOCACHE=$WORK/run/r_argvg_1/cache/go-build",
    "GOMODCACHE=$WORK/run/r_argvg_1/cache/gomod",
    "GOFLAGS=-modcacherw",
    "FAB_RUN=$TOKEN",
    "FAB_MISSION=m_argvg",
    "FAB_ATTEMPT=r_argvg_1",
    "FAB_FENCE=1",
    "FAB_RUN_DIR=$WORK/run/r_argvg_1",
    "FAB_WORKTREE=$WORK/wt/m_argvg",
    "FABRIC_HOME=$WORK/run/r_argvg_1/fabric-home",
    "FABRIC_DSN=$RUNNER_DSN"
  ],
  "grant": {
    "run": "r_argvg_1",
    "mission": "m_argvg",
    "fence": 1,
    "model": "fake-model",
    "effort": "n/a",
    "rung": "R0",
    "tier_table_sha": "test",
    "config_sha": "n/a",
    "profile": "P1",
    "max_turns": 5,
    "max_budget_usd": 0.01,
    "wall": 60000000000,
    "worktree": "$WORK/wt/m_argvg",
    "run_dir": "$WORK/run/r_argvg_1",
    "token": "$TOKEN"
  }
}
