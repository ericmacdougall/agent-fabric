# scripted codex app-server session; see fake_test.go
on initialize reply {"userAgent":"fake-codex/0"}
on thread/start reply {"thread":{"id":"{{thread}}"}}
on turn/start reply {"turn":{"id":"turn_{{seq}}","status":"inProgress","items":[]}}
on turn/start send {"method":"turn/started","params":{"threadId":"{{thread}}","turn":{"id":"turn_{{seq}}","status":"inProgress"}}}
on turn/start send {"method":"error","params":{"threadId":"{{thread}}","turnId":"turn_{{seq}}","willRetry":false,"error":{"message":"model exploded"}}}
on turn/start send {"method":"turn/completed","params":{"threadId":"{{thread}}","turn":{"id":"turn_{{seq}}","status":"failed","error":{"message":"model exploded"}}}}
